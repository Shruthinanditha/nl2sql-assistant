# .env.example
# ------------
# TEMPLATE for your real settings file. It is safe to commit because it holds NO secrets.
#
# How to use it:
#   1. Copy this file and name the copy ".env"  (Windows: Copy-Item .env.example .env)
#   2. Fill in your real values in .env
#   3. NEVER commit .env and never paste your key into a chat. .gitignore already excludes it.

# ---------- LLM (the AI model that writes SQL) ----------
# Which provider to use: gemini | anthropic | ollama | fake
#   fake = a pretend LLM with canned answers, used by the tests (free, offline)
LLM_PROVIDER=gemini

# Which model of that provider. The exact Gemini model name is verified in Phase 3
# against Google's live model list (model names change over time).
LLM_MODEL=

# Your Gemini API key from https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Only needed if LLM_PROVIDER=anthropic (https://console.anthropic.com)
ANTHROPIC_API_KEY=

# Only needed if LLM_PROVIDER=ollama (local model server)
OLLAMA_HOST=http://localhost:11434

# Seconds to wait for the LLM before giving up
LLM_TIMEOUT_SECONDS=60

# ---------- Database ----------
# Path to the SQLite database file (created in Phase 2)
DB_PATH=data/shop.db

# Maximum rows any query may return (safety + keeps the UI fast)
MAX_ROWS=500

# Maximum seconds a single SQL query may run before it is stopped
QUERY_TIMEOUT_SECONDS=5

# ---------- Logging ----------
# Where each question / SQL / verdict is logged (folder is git-ignored)
LOG_PATH=logs/queries.log
